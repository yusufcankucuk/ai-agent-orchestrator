# Leave provider keys empty to use the built-in mock model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PORT=3000
REQUEST_TIMEOUT_MS=180000
# 0 keeps subscription CLI sessions open until they finish or fail themselves.
SUBSCRIPTION_TIMEOUT_MS=0
# Workers may read and modify only this project directory.
PROJECT_WORKSPACE=work/project
# Optional override when Codex CLI is not on PATH.
CODEX_CLI_PATH=
CLAUDE_CLI_PATH=
ANTIGRAVITY_CLI_PATH=
